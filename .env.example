# Copy to .env (gitignored). Used by docker compose for Airflow UI users.
AIRFLOW_UID=1000

# Public UI URL (redirects/login). Local default.
# On server set: http://192.168.100.124/airflow
AIRFLOW__API__BASE_URL=http://localhost/airflow

# Full-access UI user
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# Read-only UI user (DAGs / logs / view only)
AIRFLOW_READONLY_USER=readonly
AIRFLOW_READONLY_PASSWORD=changeme
