# Copy to scripts/.env — shared by all three scripts:
#   lag_comparison, lag_comparison_v2, exception_monitor

# ======================
# CLICKHOUSE (lag_comparison v1)
# ======================
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=LOGISTICS

# ======================
# CLICKHOUSE V2 (exception_monitor + lag_comparison_v2)
# ======================
CLICKHOUSE_V2_USER=
CLICKHOUSE_V2_PASSWORD=
CLICKHOUSE_V2_DATABASE=LOGISTICS_V2

# ======================
# SQL SERVER
# ======================
MSSQL_SERVER=
MSSQL_DATABASES=HRM,GoGreen,Cloud_GoGreen,SharedObject
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# ======================
# WHATSAPP (exception_monitor)
# ======================
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_GROUP_NAME=

# ======================
# GOOGLE CHAT
# ======================
GOOGLE_CHAT_WEBHOOK_URL=
GOOGLE_CHAT_WEBHOOK_V2_URL=
